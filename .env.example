# --- Power: Meterless Nightshift (primary AI provider). Values come from Nightshift's Console.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=paste-from-nightshift-console
# Routing mode. meterless/auto worked and routed to a Nemotron lane in our tests;
# pin another meterless/* route here if your auto lane is not Nemotron.
METERLESS_MODEL=meterless/auto

# --- Data: Zetaris (policy rules + agent-action ledger live here)
# Local install: http://localhost:8888/api/v1.0 with ZETARIS_ORG_ID=1.
# Zetaris Cloud cluster: ZETARIS_URL=<cluster-hostname> (we append /api/v1.0), or set ZETARIS_REST_URL directly.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
# ZETARIS_URL=e181d9f0-....cloud.zetaris.com
ZETARIS_ORG_ID=1
# Create this yourself in the Zetaris web interface (guide 1.9). Never let an agent create it.
ZETARIS_API_KEY=your-zetaris-api-key
# Only needed to download the API spec; Tripwire authenticates with the API key.
ZETARIS_USER=your-sign-in-email
ZETARIS_PASSWORD=your-password
# Table prefix: creates <schema>_policy_rules and <schema>_ledger
ZETARIS_SCHEMA=tripwire

# --- Fallback only (used when Zetaris is unset/unreachable; NOT Zetaris evidence)
TRIPWIRE_FALLBACK_DB=tripwire_fallback.db
